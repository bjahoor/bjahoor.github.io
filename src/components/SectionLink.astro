---
interface Props {
  href: string;
  /** The main line. Say where it goes, not "click here". */
  label: string;
  /** The count, set in mono. */
  meta: string;
  /**
   * "row" reads as the last line of a list — same rhythm as the rows above it.
   * "display" is the page-terminal treatment: nothing follows it, so it can be
   * as large as the hero without interrupting anything.
   */
  variant?: "row" | "display";
  class?: string;
}

const {
  href,
  label,
  meta,
  variant = "row",
  class: className,
} = Astro.props;

const isDisplay = variant === "display";
---

{
  isDisplay ? (
    <a
      href={href}
      class:list={[
        "group block border-t border-line pt-8 transition-colors hover:border-accent",
        className,
      ]}
    >
      {/* The count carries the accent instead of the label: purple above and
          purple arrow to the right frames the headline without turning 60px of
          type into a colour field. */}
      <span class="block font-mono text-sm text-accent">{meta}</span>
      <span class="mt-3 flex items-center justify-between gap-6">
        <span class="text-4xl font-bold tracking-tight text-fg transition-colors group-hover:text-accent sm:text-6xl">
          {label}
        </span>
        <span
          aria-hidden="true"
          class="shrink-0 text-4xl text-accent transition-transform duration-300 group-hover:translate-x-2 sm:text-6xl"
        >
          →
        </span>
      </span>
    </a>
  ) : (
    <a
      href={href}
      class:list={[
        "group flex items-center justify-between gap-6 border-t border-line py-5 transition-colors hover:border-accent-dim",
        className,
      ]}
    >
      <span class="font-medium text-accent transition-colors group-hover:text-accent-hover">
        {label}
      </span>
      <span class="flex shrink-0 items-center gap-3">
        <span class="font-mono text-sm text-fg-dim">{meta}</span>
        <span
          aria-hidden="true"
          class="text-accent transition-transform duration-300 group-hover:translate-x-1"
        >
          →
        </span>
      </span>
    </a>
  )
}
