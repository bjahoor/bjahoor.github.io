---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import CoverImage from "../../components/CoverImage.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => b.data.weight - a.data.weight,
  );

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // Previous/next by the same ordering the index uses, so the arrows match
      // the grid the visitor just came from.
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Base title={data.title} description={data.blurb}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-8">
    <a
      href="/projects"
      class="font-mono text-sm text-fg-muted transition-colors hover:text-accent"
    >
      ← work
    </a>

    <header class="mt-8 border-b border-line pb-8">
      <div class="flex flex-wrap items-center gap-2">
        {
          data.tags.map((t) => (
            <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] text-fg-dim">
              {t.toLowerCase()}
            </span>
          ))
        }
        <span class="font-mono text-xs text-fg-dim">· {data.year}</span>
      </div>

      <h1 class="mt-5 text-4xl font-bold tracking-tight text-fg sm:text-5xl">
        {data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-fg-muted">{data.blurb}</p>

      {
        (data.repo || data.demo || data.docs) && (
          <div class="mt-7 flex flex-wrap gap-3">
            {data.repo && (
              <a
                href={data.repo}
                target="_blank"
                rel="noopener"
                class="rounded-md border border-line px-4 py-2 font-mono text-sm text-fg transition-colors hover:border-accent hover:text-accent"
              >
                source ↗
              </a>
            )}
            {data.docs && (
              <a
                href={data.docs}
                target="_blank"
                rel="noopener"
                class="rounded-md border border-line px-4 py-2 font-mono text-sm text-fg transition-colors hover:border-accent hover:text-accent"
              >
                platform docs ↗
              </a>
            )}
            {data.demo && (
              <a
                href={data.demo}
                class="rounded-md border border-line px-4 py-2 font-mono text-sm text-fg transition-colors hover:border-accent hover:text-accent"
              >
                demo video
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      data.cover && (
        <CoverImage
          src={data.cover}
          alt={data.title}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 768px, 100vw"
          loading="eager"
          class="mt-10 w-full rounded-lg border border-line"
        />
      )
    }

    <div class="prose-invert mt-12 space-y-6 text-[17px] leading-[1.75] text-fg-muted">
      <Content />
    </div>

    {
      data.stack.length > 0 && (
        <section class="mt-14 border-t border-line pt-8">
          <h2 class="font-mono text-xs tracking-widest text-fg-dim uppercase">
            Stack
          </h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {data.stack.map((s) => (
              <span class="rounded border border-line bg-surface px-2.5 py-1 font-mono text-xs text-fg-muted">
                {s}
              </span>
            ))}
          </div>
        </section>
      )
    }
  </article>

  <nav
    class="mx-auto mt-16 grid max-w-3xl grid-cols-2 gap-4 border-t border-line px-6 pt-8"
    aria-label="More projects"
  >
    <div>
      {
        prev && (
          <a href={`/projects/${prev.id}`} class="group block">
            <span class="font-mono text-xs text-fg-dim">← previous</span>
            <p class="mt-1 text-sm text-fg-muted transition-colors group-hover:text-accent">
              {prev.data.title}
            </p>
          </a>
        )
      }
    </div>
    <div class="text-right">
      {
        next && (
          <a href={`/projects/${next.id}`} class="group block">
            <span class="font-mono text-xs text-fg-dim">next →</span>
            <p class="mt-1 text-sm text-fg-muted transition-colors group-hover:text-accent">
              {next.data.title}
            </p>
          </a>
        )
      }
    </div>
  </nav>
</Base>

<style is:global>
  /* Markdown body — scoped to the project write-up */
  .prose-invert strong {
    color: var(--color-fg);
    font-weight: 600;
  }
  .prose-invert a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-invert code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-surface-2);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .prose-invert h2 {
    color: var(--color-fg);
    font-size: 1.35rem;
    font-weight: 600;
    margin-top: 2.5rem;
  }
  .prose-invert ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-invert li {
    margin-block: 0.35rem;
  }
  /* Markdown images: never overflow the column, and match the card styling. */
  .prose-invert img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.75rem 0;
    max-height: 70vh;
    width: auto;
    border: 1px solid var(--color-line);
    border-radius: 8px;
  }
</style>
