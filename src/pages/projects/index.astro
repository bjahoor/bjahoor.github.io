---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.weight - a.data.weight,
);

// Facet counts, most-used tag first. Computed at build time — the browser only
// ever receives the finished buttons.
const counts = new Map<string, number>();
for (const p of projects) {
  for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const tags = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
---

<Base
  title="Work"
  description="Robotics projects by Brandon Jahoor — simulation, perception, manipulation, autonomy, and hardware."
>
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-8">
    <h1 class="text-4xl font-bold tracking-tight text-fg sm:text-5xl">Work</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-fg-muted">
      {projects.length} projects — robot arms, rovers, hexapods, swarms, and the
      perception and control stacks that drive them.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6">
    {/* Active state is driven entirely by aria-pressed, so the script sets one
        attribute and the styling follows. */}
    <div id="filters" class="mb-10 flex flex-wrap items-center gap-2">
      <button
        type="button"
        data-tag=""
        aria-pressed="true"
        class="rounded-full border border-line px-3 py-1 font-mono text-xs text-fg-muted transition-colors hover:border-line-bright hover:text-fg aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent"
      >
        all <span class="text-fg-dim">{projects.length}</span>
      </button>
      {
        tags.map(([tag, count]) => (
          <button
            type="button"
            data-tag={tag}
            aria-pressed="false"
            class="rounded-full border border-line px-3 py-1 font-mono text-xs text-fg-muted transition-colors hover:border-line-bright hover:text-fg aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent"
          >
            {tag.toLowerCase()} <span class="text-fg-dim">{count}</span>
          </button>
        ))
      }
    </div>

    <div id="grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>

    <p
      id="empty"
      class="py-16 text-center font-mono text-sm text-fg-dim"
      style="display:none"
    >
      nothing matches that filter
    </p>
  </section>
</Base>

<script>
  // Every card is already in the DOM and indexable; filtering only hides them.
  // Inline `display` rather than a class, so no utility-order collision can
  // leave a hidden card visible.
  function initFilter() {
    const filters = document.getElementById("filters");
    const grid = document.getElementById("grid");
    const empty = document.getElementById("empty");
    if (!filters || !grid || !empty) return;

    const buttons = [...filters.querySelectorAll<HTMLButtonElement>("[data-tag]")];
    const cards = [...grid.querySelectorAll<HTMLAnchorElement>("[data-tags]")];

    function apply(tag: string) {
      let shown = 0;
      for (const card of cards) {
        const match = !tag || (card.dataset.tags ?? "").split("|").includes(tag);
        card.style.display = match ? "" : "none";
        if (match) shown++;
      }
      for (const b of buttons) {
        b.setAttribute("aria-pressed", String(b.dataset.tag === tag));
      }
      empty!.style.display = shown ? "none" : "";
    }

    filters.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-tag]");
      if (!btn) return;
      const tag = btn.dataset.tag ?? "";
      // Clicking the active facet clears it.
      apply(btn.getAttribute("aria-pressed") === "true" ? "" : tag);
    });
  }

  // Fires on first load and after every view transition.
  document.addEventListener("astro:page-load", initFilter);
</script>
