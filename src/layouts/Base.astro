---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  /** Page name. Drives og:title only — the browser tab is fixed site-wide. */
  title: string;
  description?: string;
}

const {
  title,
  description = "Brandon Jahoor — Mechatronics Engineering at the University of Waterloo. Robotics, perception, and AI on real hardware.",
} = Astro.props;

// Deliberately identical on every page.
const tabTitle = "Portfolio - Brandon Jahoor";
const canonical = new URL(Astro.url.pathname, Astro.site);

// "Work" sat next to "Experience" and read as the same thing. "Projects" is
// unambiguous; the homepage section is still headed "Selected work".
const nav = [
  { href: "/projects", label: "Projects" },
  { href: "/experience", label: "Experience" },
  { href: "https://github.com/bjahoor", label: "GitHub", external: true },
  { href: "/brandon_jahoor_resume.pdf", label: "Resume", external: true },
  { href: "https://linkedin.com/in/bjahoor", label: "LinkedIn", external: true },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <ClientRouter />
  </head>

  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-accent-solid focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <header
      class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md"
      transition:persist
    >
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-6">
        <a
          href="/"
          class="font-mono text-sm tracking-tight text-fg transition-colors hover:text-accent"
        >
          bjahoor
        </a>

        {/*
          Five items plus the wordmark is wide for a phone, so the labels drop
          a size and the gaps tighten below sm. The row can still scroll rather
          than push the page into horizontal overflow on the narrowest screens.
        */}
        <nav
          class="flex items-center gap-3 overflow-x-auto sm:gap-6"
          aria-label="Main"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener" : undefined}
                aria-current={path.startsWith(item.href) && !item.external ? "page" : undefined}
                class:list={[
                  "font-mono text-xs whitespace-nowrap transition-colors hover:text-fg sm:text-sm",
                  path.startsWith(item.href) && !item.external
                    ? "text-fg"
                    : "text-fg-muted",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-32 border-t border-line">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-10 text-sm text-fg-dim sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="font-mono">Brandon Jahoor</p>
        <div class="flex flex-wrap gap-5 font-mono">
          <a
            class="transition-colors hover:text-accent"
            href="mailto:bjahoor@uwaterloo.ca">email</a
          >
          <a
            class="transition-colors hover:text-accent"
            href="https://github.com/bjahoor"
            target="_blank"
            rel="noopener">github</a
          >
          <a
            class="transition-colors hover:text-accent"
            href="https://linkedin.com/in/bjahoor"
            target="_blank"
            rel="noopener">linkedin</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
