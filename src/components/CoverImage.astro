---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt?: string;
  /** Widths to emit in the srcset. */
  widths: number[];
  /** The `sizes` attribute — tells the browser which width it will actually need. */
  sizes: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  src,
  alt = "",
  widths,
  sizes,
  loading = "lazy",
  class: className,
} = Astro.props;

/**
 * Sharp reads only the first frame of an animated file, so running the demo
 * loops through the image pipeline would silently freeze them. They ship as-is
 * — still with width/height, which is what actually prevents layout shift.
 *
 * Every still in `src/assets/images` is a JPEG; the only WebP and GIF sources
 * in the repo are the animated loops. Keep it that way, or this check needs a
 * more explicit marker than the file extension.
 */
const isAnimated = src.format === "gif" || src.format === "webp";

/**
 * Never ask for a width the source can't supply (upscaling costs bytes and buys
 * nothing), and cap the top end — some of these originals are 4000px wide, and
 * a variant that large would only ever be downloaded by accident.
 */
const MAX_WIDTH = 1600;
const emitted = [...new Set([...widths, Math.min(src.width, MAX_WIDTH)])]
  .filter((w) => w <= src.width)
  .sort((a, b) => a - b);
---

{
  isAnimated ? (
    <img
      src={src.src}
      width={src.width}
      height={src.height}
      alt={alt}
      loading={loading}
      decoding="async"
      class={className}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={emitted}
      sizes={sizes}
      loading={loading}
      decoding="async"
      class={className}
    />
  )
}
