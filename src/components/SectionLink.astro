---
interface Props {
  href: string;
  /** The main line. Say where it goes, not "click here". */
  label: string;
  /** Right-hand count, set in mono so it lines up with the rows above. */
  meta: string;
  /** Spacing, which depends on whether it follows a ruled list or a grid. */
  class?: string;
}

const { href, label, meta, class: className } = Astro.props;
---

{/*
  Reads as the last row of the section rather than a banner sitting on top of
  it: same rhythm, same rule, same mono figure on the right as the list above.
  Obvious because it is the only accent-coloured line in the section and the
  arrow moves — not because it is big.
*/}
<a
  href={href}
  class:list={[
    "group flex items-center justify-between gap-6 border-t border-line py-5 transition-colors hover:border-accent-dim",
    className,
  ]}
>
  <span
    class="font-medium text-accent transition-colors group-hover:text-accent-hover"
  >
    {label}
  </span>

  <span class="flex shrink-0 items-center gap-3">
    <span class="font-mono text-sm text-fg-dim">{meta}</span>
    <span
      aria-hidden="true"
      class="text-accent transition-transform duration-300 group-hover:translate-x-1"
    >
      →
    </span>
  </span>
</a>
