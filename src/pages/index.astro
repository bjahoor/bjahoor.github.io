---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionLink from "../components/SectionLink.astro";
import HoverNote from "../components/HoverNote.astro";

const projects = await getCollection("projects");
const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.weight - a.data.weight);

const allExperience = (await getCollection("experience")).length;
const experience = (await getCollection("experience"))
  .filter((e) => e.data.robotics)
  .sort((a, b) => b.data.order - a.data.order)
  .slice(0, 4);
---

<Base title="Brandon Jahoor — Robotics Engineering Portfolio">
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 pt-12 pb-20 sm:pt-16">
    <p class="mb-6 font-mono text-sm text-accent">
      Mechatronics Engineering · University of Waterloo
    </p>

    <h1
      class="max-w-4xl text-4xl leading-[1.1] font-bold tracking-tight text-balance text-fg sm:text-5xl"
    >
      Robotics Software Engineering for Humanoid Embodiment of Physical AI
    </h1>

    <p class="mt-8 text-lg leading-relaxed text-fg-muted">
      Five robotics co-ops in, and as the headline probably gave away, I've
      fallen in love with <HoverNote
        label="humanoids"
        href="/projects/axibo-physical-ai"
      >
        Human-shaped, general-purpose robots: the body physical AI is built for.
      </HoverNote> (not literally). I'm&nbsp;currently pushing SOTA on the Physical AI
      team at <HoverNote
        label="Axibo AI"
        href="https://www.axibo.com/"
        external
      >
        A Canadian humanoid startup in Waterloo, Ontario.
      </HoverNote>. I've&nbsp;been part of a <HoverNote
        label="Bay Area"
        href="https://f.inc/"
        external
      >
        Thalassa Robotics, a San Francisco subsea robotics startup in the <strong
          class="text-fg">Founders, Inc</strong
        > portfolio.
      </HoverNote> robotics startup, <span class="whitespace-nowrap">the <HoverNote
        label="UW RoboHub"
        href="/projects/uw-robohub-research"
      >
        Waterloo's robotics research facility. I streamed Xsens motion capture
        into ROS 2 there.
      </HoverNote></span> research group, multiple <HoverNote
        label="Stealth Startups"
        href="/projects/chess-robot"
      >
        A chess-playing robot arm, and RL control policies trained in Isaac Lab.
      </HoverNote>, and multiple <HoverNote
        label="Student Teams"
        href="/projects/mars-style-rover"
      >
        UW Robotics Team's Mars rover, and WATonomous' autonomous navigation
        stack.
      </HoverNote>. At home I run my own unimanual robotic arm setup, with <HoverNote
        label="Jetson"
        href="https://www.nvidia.com/en-us/autonomous-machines/embedded-systems/"
        external
      >
        NVIDIA's edge-AI computers. Policies run on the robot, not in the cloud.
      </HoverNote> edge computing and <HoverNote
        label="RTX"
        href="https://www.nvidia.com/en-us/geforce/graphics-cards/"
        external
      >
        NVIDIA desktop GPUs, used for simulation and policy training.
      </HoverNote> GPUs for simulations and training policies.
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/brandon_jahoor_resume.pdf"
        target="_blank"
        rel="noopener"
        class="rounded-md bg-accent-solid px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
      >
        Resume ↗
      </a>
      <a
        href="https://linkedin.com/in/bjahoor"
        target="_blank"
        rel="noopener"
        class="rounded-md border border-line px-5 py-2.5 text-sm font-medium text-fg transition-colors hover:border-line-bright hover:text-accent"
      >
        LinkedIn ↗
      </a>
    </div>
  </section>

  <!-- Experience -->
  <section class="mx-auto max-w-5xl px-6">
    <h2
      class="mb-8 border-b border-line pb-4 font-mono text-sm tracking-widest text-fg-dim uppercase"
    >
      Experience
    </h2>

    <ul class="divide-y divide-line">
      {
        experience.map((e) => (
          <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <div>
              {e.data.url ? (
                <a
                  href={e.data.url}
                  target="_blank"
                  rel="noopener"
                  class="font-medium text-fg transition-colors hover:text-accent"
                >
                  {e.data.org}
                </a>
              ) : (
                <span class="font-medium text-fg">{e.data.org}</span>
              )}
              {e.data.sector && (
                <span class="text-fg-dim"> · {e.data.sector}</span>
              )}
              <span class="text-fg-muted"> — {e.data.role}</span>
            </div>
            <span class="shrink-0 font-mono text-sm text-fg-dim">
              {e.data.start} – {e.data.end}
            </span>
          </li>
        ))
      }
    </ul>

    <SectionLink
      href="/experience"
      label="Full experience history"
      meta={`${allExperience} roles`}
    />
  </section>

  <!-- Selected work -->
  <section class="mx-auto max-w-5xl px-6 pt-24">
    <h2
      class="mb-8 border-b border-line pb-4 font-mono text-sm tracking-widest text-fg-dim uppercase"
    >
      Selected work
    </h2>

    <div class="grid gap-5 sm:grid-cols-2">
      {featured.map((p) => <ProjectCard project={p} large />)}

      {/*
        Last cell of the grid, spanning both columns. Same border, surface,
        radius and hover as a project card, and inside the same `gap-5`, so it
        reads as the row that follows the work rather than as a separate
        section asking for a click.
      */}
      <a
        href="/projects"
        class="group flex items-center justify-between gap-6 rounded-lg border border-line bg-surface px-7 py-8 transition-colors duration-300 hover:border-line-bright focus-visible:border-accent sm:col-span-2"
      >
        <span>
          <span class="block font-mono text-xs tracking-widest text-fg-dim uppercase">
            {projects.length} projects
          </span>
          <span class="mt-2 block text-2xl font-semibold tracking-tight text-fg transition-colors group-hover:text-accent sm:text-3xl">
            Browse every project
          </span>
        </span>
        <span
          aria-hidden="true"
          class="shrink-0 text-3xl text-accent transition-transform duration-300 group-hover:translate-x-2 sm:text-4xl"
        >
          →
        </span>
      </a>
    </div>
  </section>
</Base>
