---
import type { CollectionEntry } from "astro:content";
import CoverImage from "./CoverImage.astro";

interface Props {
  project: CollectionEntry<"projects">;
  /** Larger treatment for the homepage's featured row. */
  large?: boolean;
}

const { project, large: isLarge = false } = Astro.props;
const { id, data } = project;
---

<a
  href={`/projects/${id}`}
  data-tags={data.tags.join("|")}
  class="group relative flex flex-col overflow-hidden rounded-lg border border-line bg-surface transition-colors duration-300 hover:border-line-bright focus-visible:border-accent"
>
  <div
    class:list={[
      "relative overflow-hidden bg-surface-2",
      isLarge ? "aspect-16/10" : "aspect-4/3",
    ]}
  >
    {
      data.cover ? (
        <CoverImage
          src={data.cover}
          widths={[400, 640, 900]}
          sizes={
            isLarge
              ? "(min-width: 1024px) 620px, (min-width: 640px) 50vw, 100vw"
              : "(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
          }
          class="h-full w-full object-cover opacity-90 transition-all duration-500 group-hover:scale-[1.03] group-hover:opacity-100"
        />
      ) : (
        /* No photo exists for this one yet — a typographic tile rather than a
           broken-looking empty box. */
        <div class="flex h-full w-full items-center justify-center bg-surface-2 p-6">
          <span class="font-mono text-xs tracking-widest text-fg-dim uppercase">
            {data.tags[0]}
          </span>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-2 p-5">
    <div class="flex items-baseline justify-between gap-3">
      <h3
        class:list={[
          "font-semibold text-fg transition-colors group-hover:text-accent",
          isLarge ? "text-lg" : "text-base",
        ]}
      >
        {data.title}
      </h3>
      <span class="shrink-0 font-mono text-xs text-fg-dim">{data.year}</span>
    </div>

    <p class="text-sm leading-relaxed text-fg-muted">{data.blurb}</p>

    <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
      {
        data.stack.slice(0, 3).map((s) => (
          <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[11px] text-fg-dim">
            {s}
          </span>
        ))
      }
    </div>
  </div>
</a>
